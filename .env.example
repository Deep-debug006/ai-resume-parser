# =============================================================================
# AI Resume Parser & Job Matcher - Environment Configuration Template
# Copy this file to '.env' before running docker compose or local services:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_resume_parser
POSTGRES_PORT=5432

# Database connection URL for backend service
# Inside docker compose network:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ai_resume_parser
# For local host development outside docker:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_resume_parser

# -----------------------------------------------------------------------------
# 2. FastAPI Backend Service Configuration
# -----------------------------------------------------------------------------
APP_NAME="AI Resume Parser & Job Matcher Backend"
ENVIRONMENT=development
DEBUG=true
BACKEND_PORT=8001
HOST=0.0.0.0
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# File Upload & OCR Limits
MAX_UPLOAD_SIZE_MB=10
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=50
OCR_DPI=200

# -----------------------------------------------------------------------------
# 3. AI / LLM Provider & Embedding Configuration
# -----------------------------------------------------------------------------
# Provider options: "gemini", "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.0
LLM_MAX_REPAIR_RETRIES=2

# Embedding options: "auto", "gemini", "mock"
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# -----------------------------------------------------------------------------
# Generate a cryptographically secure key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=ai_resume_parser_jwt_super_secret_key_production_grade_security_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# 5. Frontend React SPA Configuration
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
# Reverse proxy target for /api requests inside docker network
VITE_BACKEND_URL=http://backend:8001
